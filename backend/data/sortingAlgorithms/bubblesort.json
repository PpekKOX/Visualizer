{
	"name": "Bubble Sort",
	"summary": "Repeatedly walks through the array and swaps neighbouring elements that are in the wrong order.",
	"description": [
		"Bubble Sort walks through the array from left to right and compares every pair of neighbouring elements. Whenever the left element is bigger than the right one, the two are swapped. After the first pass the largest element has \"bubbled up\" to the very end of the array.",
		"Every following pass does the same for the part that is still unsorted, so the sorted section at the end grows by one element per pass. If a whole pass finishes without a single swap, the array is already sorted and the algorithm stops early.",
		"Bubble Sort is easy to understand but slow: in the worst case it needs about n²/2 comparisons. It is mostly used for teaching, or for tiny arrays that are nearly sorted."
	],
	"complexity": { "best": "O(n)", "average": "O(n²)", "worst": "O(n²)", "space": "O(1)" },
	"properties": [
		{ "label": "Stable", "value": "Yes" },
		{ "label": "In place", "value": "Yes" }
	],
	"code": {
		"javascript": {
			"lines": [
				"function bubbleSort(arr) {",
				"    const n = arr.length;",
				"    for (let i = 0; i < n - 1; i++) {",
				"        let swapped = false;",
				"        for (let j = 0; j < n - i - 1; j++) {",
				"            if (arr[j] > arr[j + 1]) {",
				"                [arr[j], arr[j + 1]] = [arr[j + 1], arr[j]];",
				"                swapped = true;",
				"            }",
				"        }",
				"        if (!swapped) break;",
				"    }",
				"    return arr;",
				"}"
			],
