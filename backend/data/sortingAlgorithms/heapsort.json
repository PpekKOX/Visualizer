				"    int n = arr.length;",
				"    for (int i = n / 2 - 1; i >= 0; i--) {",
				"        heapify(arr, n, i);",
				"    }",
				"    for (int end = n - 1; end > 0; end--) {",
				"        int temp = arr[0];",
				"        arr[0] = arr[end];",
				"        arr[end] = temp;",
				"        heapify(arr, end, 0);",
				"    }",
				"    return arr;",
				"}",
