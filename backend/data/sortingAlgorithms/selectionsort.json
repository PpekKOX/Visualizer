{
	"name": "Selection Sort",
	"summary": "Repeatedly finds the smallest remaining element and moves it to the front of the unsorted part.",
	"description": [
		"Selection Sort splits the array into a sorted part on the left and an unsorted part on the right. In every pass it scans the whole unsorted part to find its smallest element, and then swaps that element with the first unsorted one.",
		"After pass i, the first i + 1 elements are in their final positions. Unlike Bubble Sort, Selection Sort makes at most n − 1 swaps, which helps when writing to memory is expensive.",
		"The number of comparisons is always about n²/2, no matter what the input looks like, so it takes O(n²) time even for an already sorted array. The standard version is not stable: a swap can move an element past another element with the same value."
	],
	"complexity": { "best": "O(n²)", "average": "O(n²)", "worst": "O(n²)", "space": "O(1)" },
	"properties": [
		{ "label": "Stable", "value": "No" },
		{ "label": "In place", "value": "Yes" }
	],
	"code": {
		"javascript": {
			"lines": [
				"function selectionSort(arr) {",
				"    const n = arr.length;",
				"    for (let i = 0; i < n - 1; i++) {",
				"        let minIndex = i;",
				"        for (let j = i + 1; j < n; j++) {",
				"            if (arr[j] < arr[minIndex]) {",
				"                minIndex = j;",
				"            }",
				"        }",
				"        if (minIndex !== i) {",
				"            [arr[i], arr[minIndex]] = [arr[minIndex], arr[i]];",
				"        }",
				"    }",
				"    return arr;",
				"}"
			],
