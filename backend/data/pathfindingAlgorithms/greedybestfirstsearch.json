	"code": {
		"javascript": {
			"lines": [
				"function greedyBestFirstSearch(graph, h, start, goal) {",
				"    const parent = { [start]: null };",
				"    const openList = [start];",
				"",
				"    while (openList.length > 0) {",
				"        let cell = openList[0];",
				"        for (const candidate of openList) {",
				"            if (h[candidate] <= h[cell]) cell = candidate;",
				"        }",
				"        if (cell === goal) {",
				"            const path = [goal];",
				"            while (path[0] !== start) path.unshift(parent[path[0]]);",
				"            return path;",
				"        }",
				"        openList.splice(openList.indexOf(cell), 1);",
				"",
				"        for (const neighbor of graph[cell]) {",
				"            if (!(neighbor in parent)) {",
				"                parent[neighbor] = cell;",
				"                openList.push(neighbor);",
				"            }",
				"        }",
				"    }",
				"",
				"    return null;",
				"}"
			],
