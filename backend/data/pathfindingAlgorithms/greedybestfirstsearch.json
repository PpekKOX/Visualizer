			"lines": [
				"static List<String> greedyBestFirstSearch(Map<String, List<String>> graph, Map<String, Integer> h, String start, String goal) {",
				"    Map<String, String> parent = new HashMap<>();",
				"    parent.put(start, null);",
				"    List<String> openList = new ArrayList<>(List.of(start));",
				"",
				"    while (!openList.isEmpty()) {",
				"        String cell = openList.get(0);",
				"        for (String candidate : openList) {",
				"            if (h.get(candidate) <= h.get(cell)) cell = candidate;",
				"        }",
				"        if (cell.equals(goal)) {",
				"            LinkedList<String> path = new LinkedList<>(List.of(goal));",
				"            while (!path.getFirst().equals(start)) path.addFirst(parent.get(path.getFirst()));",
				"            return path;",
				"        }",
				"        openList.remove(cell);",
				"",
				"        for (String neighbor : graph.get(cell)) {",
				"            if (!parent.containsKey(neighbor)) {",
				"                parent.put(neighbor, cell);",
				"                openList.add(neighbor);",
				"            }",
				"        }",
				"    }",
				"",
				"    return null;",
				"}"
			],
